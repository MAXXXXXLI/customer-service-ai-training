# This is a non-secret reference template. prepare_server.sh creates the real
# /etc/training-kb/weknora.env with fresh random keys and mode 0600.
GIN_MODE=release
LOG_LEVEL=info
TZ=Asia/Shanghai
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DB_DRIVER=sqlite
DB_PATH=/var/lib/training-kb/weknora/weknora.db
RETRIEVE_DRIVER=sqlite
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/var/lib/training-kb/weknora/files
STREAM_MANAGER_TYPE=memory
SYSTEM_AES_KEY=GENERATED_DURING_PREPARE
JWT_SECRET=GENERATED_DURING_PREPARE
NEO4J_ENABLE=false
WEKNORA_SANDBOX_MODE=disabled
ENABLE_GRAPH_RAG=false
DISABLE_REGISTRATION=false
CONCURRENCY_POOL_SIZE=1
WEKNORA_WEB_DIR=/opt/training-kb/current/weknora/web
