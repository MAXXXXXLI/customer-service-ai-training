[Unit]
Description=WeKnora v0.7.2 Lite (native SQLite deployment)
After=network-online.target
Wants=network-online.target
ConditionPathIsExecutable=/opt/training-kb/current/weknora/WeKnora-lite
ConditionPathExists=/etc/training-kb/weknora.env

[Service]
Type=simple
User=weknora-lite
Group=weknora-lite
WorkingDirectory=/opt/training-kb/current/weknora
EnvironmentFile=/etc/training-kb/weknora.env
Environment=JIEBA_DICT_DIR=/opt/training-kb/current/weknora/jieba-dict
ExecStart=/opt/training-kb/current/weknora/WeKnora-lite
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/training-kb/weknora
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
