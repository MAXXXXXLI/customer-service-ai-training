# WeKnora v0.7.2 production profile for this knowledge migration.
# Copy to the official WeKnora checkout as .env and replace every CHANGE_ME value.
# Deployment scripts reject duplicate keys and COMPOSE_* control variables here.

WEKNORA_VERSION=v0.7.2
GIN_MODE=release
LOG_LEVEL=info
LLM_DEBUG_LOG=false
TZ=Asia/Shanghai
WEKNORA_LANGUAGE=zh-CN
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true

# Keep both management UI and API on loopback. Put HTTPS/VPN/SSH in front.
FRONTEND_PORT=127.0.0.1:18080
APP_PORT=127.0.0.1:18081
APP_HOST=app
APP_BACKEND_PORT=8080
APP_SCHEME=http
RESOURCE_URL_MODE=handle

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=weknora
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=WeKnora

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_PREFIX=stream:

STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
MAX_FILE_SIZE_MB=50
RETRIEVE_DRIVER=postgres
NEO4J_ENABLE=false

# Final production state. prepare_server.sh temporarily changes this to false
# while the service is loopback-only so that the first owner can register.
DISABLE_REGISTRATION=true
WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=false
WEKNORA_TENANT_ENABLE_RBAC=true
WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
WEKNORA_TENANT_AUTO_CREATE_API_KEY=false
OIDC_AUTH_ENABLE=false
WEKNORA_AUDIT_RETENTION_DAYS=365
# After the first Owner registers, set this email before the lock restart to
# bootstrap the deployment's first system administrator. It never creates users.
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
# Must be exactly 32 bytes. The all-zero value is deliberately invalid.
SYSTEM_AES_KEY=00000000000000000000000000000000
GRPC_AUTH_TOKEN=CHANGE_ME_GRPC_TOKEN_AT_LEAST_16_BYTES

# Conservative starting point for 8 vCPU / 32 GB with remote API models.
WEKNORA_ASYNQ_CORE_CONCURRENCY=4
WEKNORA_ASYNQ_POSTPROCESS_CONCURRENCY=2
WEKNORA_ASYNQ_ENRICHMENT_CONCURRENCY=4
WEKNORA_ASYNQ_MAINTENANCE_CONCURRENCY=2
WEKNORA_ASYNQ_SHARED_CONCURRENCY=2
WEKNORA_MODEL_MAX_CONCURRENCY=8
DOCREADER_GRPC_MAX_WORKERS=4

# The first release does not expose agent code execution, web search, MCP,
# Neo4j, MinIO, Langfuse, or optional full-profile services.
WEKNORA_SANDBOX_MODE=disabled
