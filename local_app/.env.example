# Optional: set these in your shell before starting the local server.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
# Set to 1 to force deterministic local demo responses without calling the API.
SILICONFLOW_MOCK=0

# Production knowledge retrieval. Keep both API keys only in the server-side
# environment file (mode 0600); never expose them to app.js or browser storage.
WEKNORA_BASE_URL=http://127.0.0.1:8080
WEKNORA_RETRIEVE_API_KEY=
# Runtime-only allow-list: staff courses, provisional customer FAQ, safety
# policy, and safety-boundary FAQ. Do not add the audit knowledge base.
WEKNORA_KB_IDS=
WEKNORA_TIMEOUT=30
# Fail closed instead of falling back to legacy local JSON retrieval.
WEKNORA_REQUIRED=1

# Optional server-side iFlytek streaming TTS. Either set APIPassword or the
# complete APP_ID/API_KEY/API_SECRET triplet. Never put these values in static
# files or browser storage.
IFLYTEK_TTS_APP_ID=
IFLYTEK_TTS_API_KEY=
IFLYTEK_TTS_API_SECRET=
IFLYTEK_TTS_API_PASSWORD=
IFLYTEK_TTS_ENDPOINT=wss://tts-api.xfyun.cn/v2/tts
IFLYTEK_TTS_DEFAULT_VOICE=x4_xiaoyan
IFLYTEK_TTS_FORMAT=mp3
IFLYTEK_TTS_TIMEOUT=30
IFLYTEK_TTS_MAX_TEXT_BYTES=7999
IFLYTEK_TTS_MAX_AUDIO_BYTES=12582912
IFLYTEK_TTS_CACHE_TTL=300
IFLYTEK_TTS_CACHE_SIZE=128
IFLYTEK_TTS_RATE_LIMIT=30
IFLYTEK_TTS_RATE_WINDOW=60

# Optional server-side iFlytek streaming voice dictation (speech-to-text).
# Enable the capability in the same iFlytek app; blank credential fields fall
# back to IFLYTEK_TTS_APP_ID/API_KEY/API_SECRET.
IFLYTEK_IAT_APP_ID=
IFLYTEK_IAT_API_KEY=
IFLYTEK_IAT_API_SECRET=
IFLYTEK_IAT_ENDPOINT=wss://iat-api.xfyun.cn/v2/iat
IFLYTEK_IAT_LANGUAGE=zh_cn
IFLYTEK_IAT_ACCENT=mandarin
IFLYTEK_IAT_SAMPLE_RATE=16000
IFLYTEK_IAT_MAX_DURATION_SECONDS=30
IFLYTEK_IAT_MAX_AUDIO_BYTES=960000
IFLYTEK_IAT_FRAME_BYTES=1280
IFLYTEK_IAT_FRAME_INTERVAL_SECONDS=0.04
IFLYTEK_IAT_TIMEOUT=45
IFLYTEK_IAT_RATE_LIMIT=20
IFLYTEK_IAT_RATE_WINDOW=60

HOST=127.0.0.1
PORT=8787
